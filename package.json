{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-cli": "./bin/cli.js"
  },
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "videos": "bash scripts/optimize-videos.sh",
    "predev": "npm run images",
    "dev": "next dev",
    "prebuild": "npm run images",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier": "prettier -w .",
    "analyze": "npm run images && cross-env ANALYZE=true next build",
    "preview": "npm run images && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run images && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run images && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.2.3",
    "@opennextjs/cloudflare": "^1.17.1",
    "@types/node": "18.15.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.14",
    "next": "15.5.22",
    "pdf-parse": "^2.4.5",
    "postcss": "8.5.23",
    "prettier": "^2.8.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.35.0",
    "tailwindcss": "3.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  }
}

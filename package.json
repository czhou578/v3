{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-cli": "./bin/cli.js"
  },
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "videos": "bash scripts/optimize-videos.sh",
    "icons": "node scripts/render-icons.mjs",
    "predev": "npm run images && npm run agent-files",
    "dev": "next dev",
    "prebuild": "npm run images && npm run agent-files",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "npm run images && cross-env ANALYZE=true next build",
    "preview": "npm run images && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run images && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run images && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mcp:dev": "wrangler dev -c my-portfolio-mcp/wrangler.toml",
    "mcp:deploy": "wrangler deploy -c my-portfolio-mcp/wrangler.toml",
    "mcp:typecheck": "tsc -p my-portfolio-mcp --noEmit",
    "agent-files": "node scripts/generate-agent-files.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.27",
    "@opennextjs/cloudflare": "^1.20.9",
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@eslint/eslintrc": "^3.3.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "postcss-selector-parser": "7.1.6"
  }
}
